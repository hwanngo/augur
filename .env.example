# Augur — environment template.
# Copy to `.env` and fill in. docker-compose requires the REQUIRED vars below
# (the app fails closed without them). Full reference: docs/en/CONFIGURATION.md
# Defaults shown in comments are the literal fallbacks in src/augur/.

# ============================================================================
# Core / auth
# ============================================================================

# [REQUIRED in prod] Deployment environment: dev | prod | test.
# Drives cookie-secure default and AUGUR_SECRET_KEY fail-closed behavior.
AUGUR_ENV=prod

# [REQUIRED in prod] Strong random signing key for sessions/CSRF.
# In prod a missing value fails closed (RuntimeError). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUGUR_SECRET_KEY=

# [REQUIRED — first run only] Initial admin, created ONLY while the user table
# is empty. There is no default admin password.
AUGUR_ADMIN_USER=admin
AUGUR_ADMIN_PASSWORD=

# sqlite database path (auth, alerts, hunts, generative share it).
# Put it on a persistent, access-controlled volume in prod.
# AUGUR_DB=data/augur.db

# Secure (HTTPS-only) session cookies. Truthy = 1/true/yes/on.
# Defaults to true when AUGUR_ENV=prod. Set to false ONLY when serving plain
# HTTP behind a TLS-terminating reverse proxy.
AUGUR_COOKIE_SECURE=false

# JSONL log feed the API / alerting scan reads. Point at your real corpus.
# AUGUR_LOGS=sample_data/corpus/enterprise_day.jsonl

# Logging (applied outside the test env). Format: text (default) or json for
# structured log shipping. Level: DEBUG/INFO/WARNING/ERROR (default INFO).
# AUGUR_LOG_FORMAT=json
# AUGUR_LOG_LEVEL=INFO

# ============================================================================
# Graph backend  (NetworkX default; Neo4j is opt-in)
# ============================================================================

# Set to "neo4j" to use the Neo4j backend; anything else = in-memory NetworkX.
# AUGUR_BACKEND=neo4j

# [REQUIRED by docker-compose] Neo4j credentials. docker-compose.yml fails to
# start unless NEO4J_PASSWORD is set (no baked-in default). Set a strong value.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-strong-neo4j-password

# ============================================================================
# Alerting  (background monitor is env-gated and off by default)
# ============================================================================

# Truthy (1/true/yes/on) enables the background monitor loop.
# AUGUR_MONITOR_ENABLED=false

# Monitor poll interval, seconds (float).
# AUGUR_MONITOR_INTERVAL=60

# Drop-feed directory the monitor scans. MUST be access-controlled — anyone who
# can write here can inject logs (see THREAT_MODEL T8).
# AUGUR_MONITOR_DIR=

# Minimum proximity to raise an alert (clamped 0.0–1.0).
# AUGUR_ALERT_MIN_PROXIMITY=0.6

# Cycles before an unseen alert auto-resolves (0 = never).
# AUGUR_ALERT_AUTO_RESOLVE_CYCLES=0

# JSON used ONLY to seed alert config on a fresh DB.
# AUGUR_ALERT_SINKS={"soc": {"type": "webhook", "url": "https://..."}}
# AUGUR_ALERT_RULES=[]

# Sliding scan window, seconds (0 or unset = whole feed).
# AUGUR_SCAN_WINDOW_SECONDS=0

# ============================================================================
# Connector CLI (augur.hunt) — default sink URLs
# ============================================================================

# AUGUR_WEBHOOK_URL=
# AUGUR_SLACK_WEBHOOK_URL=

# ============================================================================
# Retention / maintenance
# ============================================================================

# Default age cutoff (days) for `augur.maintenance prune` (override with --days).
# AUGUR_RETENTION_DAYS=90

# ============================================================================
# Generative / AI  — OPT-IN [ai] extra only.
# Not imported by the default path. Enabling "claude" causes scenario egress to
# Anthropic (see THREAT_MODEL T5). Leave as-is for an AI-free deployment.
# ============================================================================

# "fake" (deterministic stub, default) or "claude" (live LLM).
# AUGUR_AI_GENERATOR=fake

# [REQUIRED only if AUGUR_AI_GENERATOR=claude] Billable egress credential.
# Read from env only; never persisted.
# ANTHROPIC_API_KEY=

# AUGUR_AI_MODEL=claude-opus-4-8
# AUGUR_AI_MAX_N=10
# AUGUR_AI_MAX_TOKENS=4096
# AUGUR_AI_MAX_CALLS=30
# AUGUR_AI_WINDOW_SECONDS=900
